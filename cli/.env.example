# ==========================================
# Application Configuration
# ==========================================

# Path to the directory where containers are stored
PATH_TO_CONTAINER_FOLDER="/path/to/nocodb_webhook_5***_7***"

# Where is the schema file stored? ("local" or "remote")
SCHEMA_LOCATION="local"

# Path to the schema file (matches the location type above)
PATH_TO_SCHEMA="/path/to/schema.json"


# ==========================================
# Database / Base Configuration
# ==========================================

# Name of the table to create or interact with
TABLE_NAME="my_table_name"

# ID of the existing base
BASE_ID="my_base_id"

# OR Name for the new base 
NEW_BASE_NAME="my_new_base_name"


# ==========================================
# GitLab Configuration
# ==========================================

# The URL of the GitLab repository or instance
GITLAB_REPO_URL="https://gitlab.com/username/repo.git"

# Your personal or group GitLab API token for general API access
GITLAB_API_TOKEN="glpat-xxxxxxxxxxxxxxxxxxxx"

# The specific project token for GitLab operations
GITLAB_PROJECT_TOKEN="glpt-xxxxxxxxxxxxxxxxxxxx"