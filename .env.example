# Example environment configuration file
# Copy this to .env and modify the values

# Flask Configuration
# Set to 'production' in production
FLASK_ENV=development 
# Set to False in production
FLASK_DEBUG=True 
# Port to run the Flask app on
PORT=5000 
# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-here-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# SSH Configuration for Podman remote server
# Use either password OR key_file, not both
# Set USE_SSH to false to ignore SSH settings and run commands locally
USE_SSH=True
SSH_HOSTNAME=your-remote-server-ip-or-hostname
SSH_PORT=22
SSH_USERNAME=root

# leave empty if using key
SSH_PASSWORD=your-ssh-password

# Note: If running via Podman/Docker, this path must be the INTERNAL container path
# You will mount your local key to this path (e.g., -v ~/.ssh/id_rsa:/app/.ssh/id_rsa:ro,z)
SSH_KEY_FILE=/app/.ssh/id_rsa
# Optional ProxyJump chain
# Leave empty for direct connection
SSH_JUMP_HOSTS=
SSH_JUMP_USERS=
SSH_JUMP_PORTS=

# Container Scripts Configuration
# Path to directory containing container management scripts
NIHOOK_FOLDER=/path/to/nihook/scripts
CONTAINER_SCRIPTS_DIR=/path/to/container-scripts
SPIN_UP_SCRIPT=spin_up_new_instance.sh
RESTART_SCRIPT=restart_instances.sh
RESUME_SCRIPT=resume_instances.sh

# Database Configuration
DATABASE_URL=sqlite:///containers.db